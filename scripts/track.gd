## Dense, smoothed centerline. points[0] sits on the start/finish line.
var points := PackedVector2Array()


func _init() -> void:
	points = _catmull_rom(control_points, SMOOTH_STEPS)


## Index into `points` where sector k (0-based) begins.
func sector_start(k: int) -> int:
	return SECTOR_CONTROL_POINTS[k] * SMOOTH_STEPS


## Returns {"index": nearest centerline segment, "distance": px from centerline}.
func nearest(pos: Vector2) -> Dictionary:
	var best_index := 0
	var best_distance := INF
	var n := points.size()
	for i in n:
		var closest := Geometry2D.get_closest_point_to_segment(pos, points[i], points[(i + 1) % n])
		var d := pos.distance_to(closest)
		if d < best_distance:
			best_distance = d
			best_index = i
	return {"index": best_index, "distance": best_distance}


func _draw() -> void:
	var n := points.size()
	var closed := points.duplicate()
	closed.append(points[0])

	# Red/white curbs, then the road surface on top.
	for i in n:
		draw_circle(points[i], WIDTH * 0.5 + CURB, CURB_RED if i % 6 < 3 else CURB_WHITE)
	for i in n:
		draw_circle(points[i], WIDTH * 0.5, ROAD_COLOR)
	draw_polyline(closed, ROAD_COLOR, WIDTH)

	# Dashed center line.
	for i in range(0, n, 2):
		draw_line(points[i], points[(i + 1) % n], LANE_COLOR, 4.0)

	_draw_start_line()
	_draw_sector_lines()


func _draw_sector_lines() -> void:
	var font := ThemeDB.fallback_font
	for k in SECTOR_COUNT:
		var i := sector_start(k)
		var origin := points[i]
		var dir := (points[i + 1] - points[i]).normalized()
		var across := dir.orthogonal()
		var half := WIDTH * 0.5 + CURB
		if k > 0:  # sector 1 starts at the checkered line
			draw_line(origin - across * half, origin + across * half, SECTOR_LINE_COLOR, 6.0)
		# Label on the outside of the track, just past the line.
		var label_pos := origin + across * (half + 16.0) + dir * 12.0
		draw_string_outline(font, label_pos, "S%d" % (k + 1), HORIZONTAL_ALIGNMENT_LEFT, -1, 36, 6, Color.BLACK)
		draw_string(font, label_pos, "S%d" % (k + 1), HORIZONTAL_ALIGNMENT_LEFT, -1, 36, SECTOR_LINE_COLOR)


func _draw_start_line() -> void:
	var origin := points[0]
	var dir := (points[1] - points[0]).normalized()
	var across := dir.orthogonal()
	var size := 14.0
	var count := int(WIDTH / size)
	for row in 2:
		for col in count:
			var center := origin + across * (-WIDTH * 0.5 + size * (col + 0.5)) + dir * (size * (row - 0.5))
			var hx := dir * size * 0.5
			var hy := across * size * 0.5
			var color := Color.WHITE if (row + col) % 2 == 0 else Color.BLACK
			draw_colored_polygon(PackedVector2Array([
				center - hx - hy, center + hx - hy, center + hx + hy, center - hx + hy,
			]), color)


static func _catmull_rom(ctrl: Array[Vector2], steps: int) -> PackedVector2Array:
	var out := PackedVector2Array()
	var n := ctrl.size()
	for i in n:
		var p0 := ctrl[(i - 1 + n) % n]
		var p1 := ctrl[i]
		var p2 := ctrl[(i + 1) % n]
		var p3 := ctrl[(i + 2) % n]
		for s in steps:
			var t := float(s) / steps
			var t2 := t * t
			var t3 := t2 * t
			out.append(0.5 * (
				2.0 * p1
				+ (p2 - p0) * t
				+ (2.0 * p0 - 5.0 * p1 + 4.0 * p2 - p3) * t2
				+ (3.0 * p1 - p0 - 3.0 * p2 + p3) * t3
			))
	return out
